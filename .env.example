# ComplyFlow AI — example environment file. Contains no secrets.
# Copy to .env and fill in a real value only if you want live hosted AI analysis.
#
# LOVABLE_API_KEY is read SERVER-SIDE ONLY, inside the server function handler in
# src/lib/analyze.functions.ts. It must never be prefixed with VITE_ and is never
# exposed to the browser bundle.
#
# If it is absent, the app still works: every analysis falls back to the
# deterministic on-device engine (src/lib/local-engine.ts).
LOVABLE_API_KEY=
